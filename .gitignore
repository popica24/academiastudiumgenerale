# macOS
.DS_Store

# fișierele temporare ale auditului, dacă rularea a fost întreruptă
_audit_*.html

# spațiul de lucru al planurilor executate cu subagenți: ledger, brief-uri,
# rapoarte, pachete de revizuire. Istoricul git e evidența, nu directorul ăsta.
.superpowers/

# capturile de pe Instagram din care s-au decupat portretele profesorilor.
# 75 MB de PNG la 4000×3000, cat opt capturi de ecran retina; portretele
# taiate din ele sunt in assets/foto/profesori/ si alea se publica. Sursele
# raman doar pe discul de lucru: daca trebuie retaiat un portret, se pun
# inapoi in assets/teachers/ si se ruleaza tools/taie-profesori.py.
assets/teachers/

# videoul de prezentare așa cum a venit de la client: 94 MB, 1080p. Pagina
# încarcă assets/video/prezentare.mp4, recodat la 720p și 14 MB.
assets/video.mp4

# datele de acces la MySQL. Fișierul stă DOAR pe server, pus o dată prin FTP.
# Dacă ar intra în git, parola bazei de date ar ajunge în istoric, de unde nu
# se mai scoate. Acțiunea de deploy îl are și ea în lista de excluderi, deci
# nici nu se urcă și nici nu se suprascrie cel de pe server.
inc/config.php
