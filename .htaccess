# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php8_module>
   php_value error_log "/home/kwgvtdaq/logs/php.error.log"
   php_flag log_errors On
</IfModule>
<IfModule lsapi_module>
   php_value error_log "/home/kwgvtdaq/logs/php.error.log"
   php_flag log_errors On
</IfModule>
# END cPanel-generated php ini directives, do not edit

# --- Erorile nu se afișează în pagină ---------------------------------------
# Blocul de deasupra pornește jurnalul, dar nu oprește afișarea: implicit,
# PHP arată erorile direct pe pagină. O excepție necaptată ar putea scrie
# acolo un mesaj cu urme din bază, vizibil oricui, nu doar în jurnal. Erorile
# tot se scriu în php.error.log, unde se caută la nevoie.
<IfModule php8_module>
   php_flag display_errors Off
</IfModule>
<IfModule lsapi_module>
   php_flag display_errors Off
</IfModule>

# ══════════════════════════════════════════════════════════════════════════
# De aici în jos sunt regulile site-ului. Blocul de deasupra e pus de cPanel
# și se păstrează cuvânt cu cuvânt: îl regenerează MultiPHP INI Editor, iar
# el trimite erorile de PHP în /home/…/logs/php.error.log. Acolo se caută
# când o pagină PHP se poartă ciudat pe server.
#
# Tot ce urmează făcea vercel.json până la mutarea pe găzduire. Pe Vercel,
# antetele de cache, cele de securitate și pagina de eroare veneau din el;
# aici nu le mai pune nimeni, deci le punem noi. Fără ele site-ul merge, dar
# fiecare vizitator descarcă din nou toate fonturile și toate pozele, iar o
# adresă greșită arată eroarea seacă a serverului în loc de 404.html.
# ══════════════════════════════════════════════════════════════════════════

# --- Pagina de eroare ------------------------------------------------------
# Calea e absolută fiindcă 404.html se servește la orice adresă greșită,
# inclusiv /en/ceva/gresit. Din același motiv are căi absolute și în HTML.
ErrorDocument 404 /404.html

# --- Fișierele .txt sunt text, cu diacritice -------------------------------
# llms.txt și robots.txt sunt în română. Fără charset, browserul ghicește și
# strică ă, ș, ț.
AddType "text/plain; charset=UTF-8" .txt

# --- Lista deploy-ului nu e a vizitatorilor --------------------------------
# Acțiunea de pe GitHub ține pe server lista fișierelor urcate. Nu e un
# secret, dar e harta întregului site și n-are de ce să fie publică.
<Files ".deploy-state.json">
  Require all denied
</Files>

# --- inc/ nu se cere din browser -------------------------------------------
# Al doilea gard peste inc/.htaccess: acolo stau datele de acces la MySQL.
<FilesMatch "^config\.php$">
  Require all denied
</FilesMatch>

# --- header.php și footer.php nu se cer direct din browser -----------------
# Cele două sunt bucăți de pagină, nu pagini: header.php se oprește la un
# <main> nedeschis, footer.php e doar un fragment. „require" din PHP citește
# fișierul de pe disc, nu prin HTTP, deci includerile din blog/, admin/ și
# celelalte pagini PHP merg mai departe neatinse. Regula prinde numele
# oriunde ar sta, la rădăcină sau în subdirectoare.
<FilesMatch "^(header|footer)\.php$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  # --- Antete de securitate, pe tot site-ul --------------------------------
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # --- Cache --------------------------------------------------------------
  # Fonturile un an și „immutable": sunt subsetate de noi și nu se schimbă
  # decât dacă li se schimbă și numele.
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Restul fișierelor care nu poartă text, o lună, ca pe Vercel.
  <FilesMatch "\.(css|js|webp|jpg|jpeg|png|ico|mp4|svg|webmanifest)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # Paginile nu se țin în cache: altfel un text schimbat azi s-ar vedea abia
  # peste o lună. „must-revalidate" lasă browserul să întrebe, nu să ghicească.
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# --- Blogul ----------------------------------------------------------------
# Adresele articolelor sunt /blog/titlul-articolului, nu /blog/?id=7: se
# citesc, se rețin și spun despre ce e vorba, și oamenilor, și motoarelor.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Vechile fișiere statice. Se păstrează redirectul chiar dacă fișierele se
  # șterg de pe server: un link trimis cuiva înainte de mutare trebuie să
  # ajungă undeva, nu în 404.
  RewriteRule ^blog\.html$          /blog/ [R=301,L]
  RewriteRule ^blog-articol\.html$  /blog/ [R=301,L]

  # Harta blogului, scrisă prima din citire, nu din nevoie: regulile nu se
  # suprapun, fiindcă tiparul de articol nu se potrivește pe un nume cu
  # punct în el, deci „sitemap.xml" nu poate fi citit ca slug oricum le-ai
  # ordona.
  RewriteRule ^blog/sitemap\.xml$   blog/sitemap.php [L]

  # Lista.
  RewriteRule ^blog/?$              blog/index.php [L]

  # Un articol. Slugul e numai litere mici, cifre și cratime, exact ce scoate
  # slug(); orice altceva nu se potrivește aici și cade în 404. Fără QSA:
  # slugul vine din cale, nu din query string, iar cu QSA un „?slug=" adăugat
  # de mână la adresă s-ar alătura celui din substituție și, la chei
  # duplicate, PHP ține ultima valoare, adică pe cea din query string, nu pe
  # cea din cale.
  RewriteRule ^blog/([a-z0-9-]+)/?$ blog/articol.php?slug=$1 [L]
</IfModule>

# Notă: „Tabloul nu se indexează" NU stă aici. Un FilesMatch pe „index.php"
# la rădăcină ar prinde și blog/index.php, adică ar scoate din index chiar
# lista articolelor, singura pagină pentru care există tot blogul. Regula
# stă în admin/.htaccess, unde prinde numai fișierele din tablou.
